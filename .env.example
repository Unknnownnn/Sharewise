OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free
API_PORT=8787

# --- Splitwise bridge (optional) ---
# Sending to Splitwise runs in the same process as the API server.
# Set SPLITWISE_ENABLED=0 to skip the browser warm-up entirely.
SPLITWISE_ENABLED=1
# Persistent Chromium profile that holds the Splitwise session cookies.
SPLITWISE_PROFILE=./data/splitwise-profile
# 0 shows the browser window (handy for debugging), 1 is headless.
SPLITWISE_HEADLESS=1
# How often the session is pinged to keep it alive, in minutes.
SPLITWISE_KEEPALIVE_MINUTES=30
# Allow loopback callers to send without signing in. Set to 0 on a shared box.
SPLITWISE_ALLOW_LOCAL=1

# Paste the whole Cookie header from an authenticated splitwise.com request.
# Run `npm run splitwise:seed` once, then delete the value from .env.
SPLITWISE_COOKIE=
